# Campus Resource Autopilot - Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.

# Application Environment (development, staging, production)
ENVIRONMENT=development

# Database Connection URL (Defaults to local SQLite file for development)
# Normal startup will initialize tables without clearing existing telemetry.
DATABASE_URL=sqlite:///./data/campus.db

# Production Database Example (PostgreSQL):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campus_autopilot

# Frontend API URL (Used by Vite dev server / build)
# VITE_API_URL=http://localhost:8000/api
